{
  "name": "scfm-eval-env",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.testing.pytestArgs": ["tests"],
        "python.testing.unittestEnabled": false,
        "python.testing.pytestEnabled": true
      },
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter@2025.7.0",
        "charliermarsh.ruff"
      ]
    }
  },
  "remoteUser": "appuser",
  "postCreateCommand": "uv sync --frozen",
  "workspaceMount": "source=${localWorkspaceFolder},target=/app,type=bind",
  "workspaceFolder": "/app",
  "mounts": [
    "source=/local/home/rvander/scFoundation,target=/scFoundation,type=bind,readonly",
    "source=/local/home/rvander/CancerFoundation,target=/CancerFoundation,type=bind,readonly"
  ],
  "runArgs": [
    "--gpus", "all",
    "--shm-size", "8g"
  ]
}
